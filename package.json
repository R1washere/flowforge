{
  "name": "flowforge",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow automation builder for webhooks, scheduled jobs, retries, and execution logs.",
  "scripts": {
    "dev": "pnpm --parallel --filter @flowforge/web --filter @flowforge/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "verify": "node scripts/local-verify.mjs",
    "test:api": "node scripts/api-smoke-test.mjs",
    "test:e2e": "pnpm db:setup && playwright test",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx,js,json,md}\" && node node_modules/prisma/build/index.js format",
    "db:setup": "node scripts/setup-sqlite.mjs && pnpm db:generate && pnpm db:seed",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
